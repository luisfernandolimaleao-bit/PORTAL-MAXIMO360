rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Contador de acessos por usuário autenticado.
    // Cada usuário só pode escrever no próprio documento (uid == id do doc).
    // Leitura via app é sempre negada — os dados são consultados pelo dono
    // do projeto diretamente no Firebase Console (que não passa por estas regras).
    match /acessos/{userId} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Bloqueio padrão para qualquer outra coleção não listada acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
